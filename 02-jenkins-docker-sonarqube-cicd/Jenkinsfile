
pipeline {

    agent {
        label 'docker-agent'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            steps {
                sh '''
                    cd 02-jenkins-docker-sonarqube-cicd/application
                    ./test.sh
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    script {
                        def scannerHome = tool 'SonarScanner'

                        sh """
                            cd 02-jenkins-docker-sonarqube-cicd/application
                            ${scannerHome}/bin/sonar-scanner
                        """
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    cd 02-jenkins-docker-sonarqube-cicd/application
                    docker build -t devops-cicd-demo:latest .
                '''
            }
        }
    }
}

